{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/secrets/**)",
      "Bash(rm -rf *)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(docker compose down *)",
      "Bash(docker volume *)",
      "Bash(sudo *)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose config *)",
      "Bash(docker compose ps *)",
      "Bash(docker ps *)"
    ]
  }
}
