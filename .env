# HomeLab - zmienne środowiskowe
# Skopiuj ten plik do .env i uzupełnij wartości
# NIE commituj .env do repozytorium

# === Ogólne ===
TZ=Europe/Warsaw
DOMAIN=home.local

# === Vaultwarden ===
VAULTWARDEN_ADMIN_TOKEN=zmien_na_losowy_token_min_32_znaki

# === Portainer ===
# brak dodatkowych zmiennych

# === Watchtower ===
WATCHTOWER_SCHEDULE=0 0 3 * * *   # codziennie o 3:00
