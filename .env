# HomeLab - globalny szablon zmiennych
# Każda usługa ma własny plik services/<nazwa>/.env
# Ten plik służy jako referencyjna lista wszystkich zmiennych w projekcie

# === Wspólne ===
# TZ=Europe/Warsaw
# DOMAIN=home.local

# === Vaultwarden ===
# VAULTWARDEN_ADMIN_TOKEN=zmien_na_losowy_token_min_32_znaki  (openssl rand -base64 48)

# === Pi-hole ===
# PIHOLE_WEBPASSWORD=zmien_na_haslo_do_panelu

# === Watchtower ===
# WATCHTOWER_SCHEDULE=0 0 3 * * *
