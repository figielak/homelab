# Tandoor Recipes - Environment Variables

# Django secret key — wygeneruj: openssl rand -hex 32
TANDOOR_SECRET_KEY=change_this_secret_key

# Strefa czasowa
TZ=Europe/Warsaw

# Baza danych PostgreSQL
POSTGRES_USER=tandoor
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=tandoor

# Dozwolone hosty (oddziel przecinkami, dodaj też localhost na potrzeby health checków)
ALLOWED_HOSTS=tandoor.home.local,localhost
