# Skopiuj jako .env obok docker-compose.yml. Plik .env jest w .gitignore.

# Korzen danych wszystkich stackow na hoscie.
DATA_ROOT=/srv/homelab/data

# Pobrane pliki. Dzis na SSD systemu, bo HDD nie jest podlaczony.
# Po podlaczeniu HDD: /mnt/hdd/media/metube — zmiana tylko tutaj.
DOWNLOADS_DIR=/srv/homelab/data/metube/downloads
