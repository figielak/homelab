{
	# Adres do powiadomien Let's Encrypt o wygasajacych certyfikatach.
	email {$ACME_EMAIL}
}

# Jeden certyfikat wildcard obsluguje wszystkie uslugi.
#
# Walidacja DNS-01: Caddy dokłada tymczasowy rekord TXT w Cloudflare
# i kasuje go po weryfikacji. Nie wymaga wystawiania portu 80 na swiat
# ani zadnych stalych rekordow A w publicznym DNS.
#
# W logach Certificate Transparency widac tylko *.home.figielak.dev,
# a nie liste uslug — to swiadomy powod, dla ktorego bierzemy wildcard
# zamiast certyfikatu na kazda nazwe osobno.
*.home.figielak.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	@adguard host adguard.home.figielak.dev
	handle @adguard {
		# AdGuard dziala w network_mode: host, wiec nie nalezy do sieci
		# proxy i nie da sie go zaadresowac nazwa kontenera.
		# Adres hosta pochodzi z .env — przy migracji zmienia sie
		# jedna zmienna, nie ten plik.
		reverse_proxy {$HOST_IP}:3000
	}

	@mealie host mealie.home.figielak.dev
	handle @mealie {
		# Mealie nalezy do sieci proxy, wiec adresujemy go nazwa kontenera.
		reverse_proxy mealie:9000
	}

	@uptime-kuma host uptime-kuma.home.figielak.dev
	handle @uptime-kuma {
		# Panel uzywa WebSocketow — Caddy przepuszcza je domyslnie.
		reverse_proxy uptime-kuma:3001
	}

	@beszel host beszel.home.figielak.dev
	handle @beszel {
		reverse_proxy beszel:8090
	}

	@calibre-web host calibre-web.home.figielak.dev
	handle @calibre-web {
		reverse_proxy calibre-web:8083
	}

	# Nazwa pasujaca do wildcardu, ale nieprzypisana do zadnej uslugi.
	# Bez tego Caddy zwrocilby pusta odpowiedz i diagnostyka bylaby trudniejsza.
	handle {
		respond "Brak takiej uslugi w homelabie" 404
	}
}
