# Skopiuj jako .env obok docker-compose.yml. Plik .env jest w .gitignore.

# Korzen danych wszystkich stackow na hoscie.
DATA_ROOT=/srv/homelab/data

# Adres hosta, pod ktorym Caddy siega do uslug dzialajacych poza siecia
# `proxy` (AdGuard w network_mode: host). Przy migracji na inny sprzet
# zmieniasz tutaj i w reszcie stackow, nie w plikach konfiguracyjnych.
HOST_IP=192.168.10.10

# Adres e-mail dla Let's Encrypt — powiadomienia o wygasajacych certyfikatach.
ACME_EMAIL=

# Token API Cloudflare, zakres: Zone:Read + DNS:Edit, TYLKO strefa figielak.dev.
# Nie uzywaj Global API Key — daje pelny dostep do konta.
# Wartosc: menedzer hasel, wpis „Homelab Cloudflare DNS token".
CF_API_TOKEN=
