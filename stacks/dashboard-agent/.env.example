# Skopiuj jako .env obok docker-compose.yml. Plik .env jest w .gitignore.
# Wszystkie adresy trzymamy tutaj, nie w config.json — repo nie zawiera
# nazw hostow ani domen, ktore trafiaja na publiczna strone.

# Korzen danych wszystkich stackow na hoscie.
DATA_ROOT=/srv/homelab/data

# Endpoint dashboardu i token (menedzer hasel: "figielak.dev push token",
# ta sama wartosc w Secret Manager strony).
PUSH_URL=
PUSH_TOKEN=

# Uptime Kuma przez Caddy (agent w trybie host nie widzi nazw kontenerow).
# API key: Kuma > Settings > API Keys (menedzer hasel: "Homelab Kuma API key").
KUMA_URL=
KUMA_API_KEY=
# Push monitor "Dashboard agent" — pelny URL z Kumy, zawiera token.
KUMA_PUSH_URL=

# AdGuard w trybie host, panel na 127.0.0.1:3000.
ADGUARD_URL=http://127.0.0.1:3000
ADGUARD_USER=
ADGUARD_PASSWORD=

# Socket proxy stacku beszel (tylko GET).
DOCKER_URL=http://127.0.0.1:2375
