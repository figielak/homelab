# Skopiuj jako .env obok docker-compose.yml. Plik .env jest w .gitignore.

# Korzen danych wszystkich stackow na hoscie.
DATA_ROOT=/srv/homelab/data

# Klucz publiczny huba — skopiuj z UI Beszela (Add system) po pierwszym
# uruchomieniu huba. Do tego czasu agent nie wstanie poprawnie.
BESZEL_AGENT_KEY=
